#. i18n: ectx: attribute (title), widget (QWidget, tab_3)
#: contactsagentsettingswidget.ui:27
#, kde-format
msgid "Settings"
msgstr "सेटिंग्स्"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: contactsagentsettingswidget.ui:33
#, kde-format
msgid "Directory Name"
msgstr "निर्देशिका नाम"

#. i18n: ectx: property (text), widget (QLabel, label)
#: contactsagentsettingswidget.ui:41
#, kde-format
msgid "Di&rectory:"
msgstr "Di&rectory:"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#: contactsagentsettingswidget.ui:56
#, kde-format
msgid ""
"Select the directory whose contents should be represented by this resource. "
"If the directory does not exist, it will be created."
msgstr ""
"यस्याः सामग्रीः एतेन संसाधनेन प्रतिनिधित्वं कर्तव्यं तत् निर्देशिकां चिनोतु । यदि निर्देशिका "
"नास्ति तर्हि तस्याः निर्माणं भविष्यति ।"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: contactsagentsettingswidget.ui:69
#, kde-format
msgid "Access Rights"
msgstr "अभिगमन अधिकार"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: contactsagentsettingswidget.ui:75
#, kde-format
msgctxt "if the access is limited to read-only"
msgid "Read only"
msgstr "केवलं पठन्तु"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: contactsagentsettingswidget.ui:82
#, kde-format
msgid ""
"If read-only mode is enabled, no changes will be written to the directory "
"selected above. Read-only mode will be automatically enabled if you do not "
"have write access to the directory."
msgstr ""
"यदि केवलं पठनीयविधिः सक्षमः अस्ति तर्हि उपरि चयनितनिर्देशिकायां कोऽपि परिवर्तनः न "
"लिखितः भविष्यति । यदि भवतः निर्देशिकायां लेखनप्रवेशः नास्ति तर्हि केवलं पठनीयविधिः "
"स्वयमेव सक्षमः भविष्यति ।"

#: contactsresource.cpp:45
#, kde-format
msgid "Personal Contacts"
msgstr "व्यक्तिगत सम्पर्क"

#: contactsresource.cpp:125
#, kde-format
msgid "Directory '%1' does not exists"
msgstr "'%1' निर्देशिका नास्ति"

#: contactsresource.cpp:149 contactsresource.cpp:224
#, kde-format
msgid "Found file of unknown format: '%1'"
msgstr "अज्ञातस्वरूपस्य सञ्चिका प्राप्ता: '%1'."

#: contactsresource.cpp:198
#, kde-format
msgid "Unable to open file '%1'"
msgstr "'%1' सञ्चिकां उद्घाटयितुं असमर्थः।"

#: contactsresource.cpp:208
#, kde-format
msgid "Found invalid contact in file '%1'"
msgstr "'%1' सञ्चिकायां अमान्यः सम्पर्कः प्राप्तः ।"

#: contactsresource.cpp:218
#, kde-format
msgid "Found invalid contact group in file '%1': %2"
msgstr "'%1' सञ्चिकायां अमान्यः सम्पर्कसमूहः प्राप्तः: %2"

#: contactsresource.cpp:234 contactsresource.cpp:359 contactsresource.cpp:380
#: contactsresource.cpp:413
#, kde-format
msgid "Trying to write to a read-only directory: '%1'"
msgstr "केवलं पठनीयनिर्देशिकायां लिखितुं प्रयतते: '%1'."

#: contactsresource.cpp:252 contactsresource.cpp:267 contactsresource.cpp:302
#: contactsresource.cpp:314
#, kde-format
msgid "Unable to write to file '%1': %2"
msgstr "'%1' सञ्चिकायां लेखितुं असमर्थः: %2"

#: contactsresource.cpp:286 contactsresource.cpp:334
#, kde-format
msgid "Trying to write to a read-only file: '%1'"
msgstr "केवलं पठनीयसञ्चिकायां लिखितुं प्रयतते: '%1'."

#: contactsresource.cpp:324
#, kde-format
msgid "Received item with unknown payload %1"
msgstr "अज्ञात पेलोड् %1 इत्यनेन सह द्रव्यं प्राप्तम्"

#: contactsresource.cpp:349
#, kde-format
msgid "Unable to remove file '%1'"
msgstr "'%1' सञ्चिकां निष्कासयितुं असमर्थः ।"

#: contactsresource.cpp:366
#, kde-format
msgid "Unable to create folder '%1'."
msgstr "'%1' पुटं निर्मातुं असमर्थम् ।"

#: contactsresource.cpp:401
#, kde-format
msgid "Unable to rename folder '%1'."
msgstr "'%1' पुटस्य नाम परिवर्तनं कर्तुं असमर्थम् ।"

#: contactsresource.cpp:419
#, kde-format
msgid "Unknown folder to delete."
msgstr "विलोपयितुं अज्ञातपुटम्।"

#: contactsresource.cpp:423
#, kde-format
msgid "Unable to delete folder '%1'."
msgstr "'%1' पुटं विलोपयितुं असमर्थः ।"

#: contactsresource.cpp:438
#, kde-format
msgid "Unable to move file '%1' to '%2', '%2' already exists."
msgstr "'%1' सञ्चिकां '%2' मध्ये स्थानान्तरयितुं असमर्थः, '%2' पूर्वमेव अस्ति ।"

#: contactsresource.cpp:452
#, kde-format
msgid "Unable to move directory '%1' to '%2', '%2' already exists."
msgstr "'%1' निर्देशिकां '%2' मध्ये स्थानान्तरयितुं असमर्थः, '%2' पूर्वमेव अस्ति ।"

#. i18n: ectx: label, entry (Path), group (General)
#: contactsresource.kcfg:10
#, kde-format
msgid "Path to contacts directory"
msgstr "सम्पर्कनिर्देशिकायाः मार्गः"

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: contactsresource.kcfg:14
#, kde-format
msgid "Do not change the actual backend data."
msgstr "वास्तविकं पृष्ठभागदत्तांशं न परिवर्तयन्तु ।"

#: contactssettingswidget.cpp:40
#, kde-format
msgid "Activities"
msgstr "गतिविधयः"
