#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "Chyba při mazání podsložky '%1'."

#: maildirresource.cpp:687
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "Nelze vytvořit maildir '%1'."

#: maildirresource.cpp:697
#, kde-format
