#. i18n: ectx: attribute (title), widget (QWidget, tab_3)
#: contactsagentsettingswidget.ui:27
#, kde-format
msgid "Settings"
msgstr "הגדרות"

#. i18n: ectx: property (title), widget (QGroupBox, groupBox_2)
#: contactsagentsettingswidget.ui:33
#, kde-format
msgid "Directory Name"
msgstr "שם התיקייה"

#. i18n: ectx: property (text), widget (QLabel, label)
#: contactsagentsettingswidget.ui:41
#, kde-format
msgid "Di&rectory:"
msgstr "&תיקייה:"

#. i18n: ectx: property (text), widget (QLabel, label_3)
#: contactsagentsettingswidget.ui:56
#, kde-format
msgid ""
"Select the directory whose contents should be represented by this resource. "
"If the directory does not exist, it will be created."
msgstr ""
"נא לבחור את התיקייה שהתוכן שלה ייוצג על ידי המשאב הזה. אם התיקייה לא קיימת, "
"היא תיווצר."

#. i18n: ectx: property (title), widget (QGroupBox, groupBox)
#: contactsagentsettingswidget.ui:69
#, kde-format
msgid "Access Rights"
msgstr "הרשאות גישה"

#. i18n: ectx: property (text), widget (QCheckBox, kcfg_ReadOnly)
#: contactsagentsettingswidget.ui:75
#, kde-format
msgctxt "if the access is limited to read-only"
msgid "Read only"
msgstr "לקריאה בלבד"

#. i18n: ectx: property (text), widget (QLabel, label_2)
#: contactsagentsettingswidget.ui:82
#, kde-format
msgid ""
"If read-only mode is enabled, no changes will be written to the directory "
"selected above. Read-only mode will be automatically enabled if you do not "
"have write access to the directory."
msgstr ""
"אם מצב קריאה בלבד פעיל, לא ייכתבו שינויים לתיקייה שנבחרה לעיל. מצב לקריאה "
"בלבד יופעל אוטומטית אם אין לך הרשאות כתיבה לתיקייה."

#: contactsresource.cpp:53
#, kde-format
msgid "Personal Contacts"
msgstr "אנשי קשר פרטיים"

#: contactsresource.cpp:136
#, kde-format
msgid "Directory '%1' does not exists"
msgstr "התיקייה ‚%1’ לא קיימת"

#: contactsresource.cpp:160 contactsresource.cpp:235
#, kde-format
msgid "Found file of unknown format: '%1'"
msgstr "נמצא קובץ בתבנית לא מוכרת: ‚%1’"

#: contactsresource.cpp:209
#, kde-format
msgid "Unable to open file '%1'"
msgstr "לא ניתן לפתוח את הקובץ ‚%1’"

#: contactsresource.cpp:219
#, kde-format
msgid "Found invalid contact in file '%1'"
msgstr "נמצא איש קשר שגוי בקובץ ‚%1’"

#: contactsresource.cpp:229
#, kde-format
msgid "Found invalid contact group in file '%1': %2"
msgstr "נמצאה קבוצת קשר שגויה בקובץ ‚%1’: %2"

#: contactsresource.cpp:245 contactsresource.cpp:370 contactsresource.cpp:391
#: contactsresource.cpp:424
#, kde-format
msgid "Trying to write to a read-only directory: '%1'"
msgstr "מתבצע ניסיון לכתוב לתיקייה לקריאה בלבד: ‚%1’"

#: contactsresource.cpp:263 contactsresource.cpp:278 contactsresource.cpp:313
#: contactsresource.cpp:325
#, kde-format
msgid "Unable to write to file '%1': %2"
msgstr "לא ניתן לכתוב לקובץ ‚%1’: %2"

#: contactsresource.cpp:297 contactsresource.cpp:345
#, kde-format
msgid "Trying to write to a read-only file: '%1'"
msgstr "מתבצע ניסיון לכתוב לקובץ לקריאה בלבד: ‚%1’"

#: contactsresource.cpp:335
#, kde-format
msgid "Received item with unknown payload %1"
msgstr "התקבל פריט עם מטען לא מוכר %1"

#: contactsresource.cpp:360
#, kde-format
msgid "Unable to remove file '%1'"
msgstr "לא ניתן להסיר את הקובץ ‚%1’"

#: contactsresource.cpp:377
#, kde-format
msgid "Unable to create folder '%1'."
msgstr "לא ניתן ליצור את התיקייה ‚%1’."

#: contactsresource.cpp:412
#, kde-format
msgid "Unable to rename folder '%1'."
msgstr "לא ניתן לשנות את שם התיקייה ‚%1’."

#: contactsresource.cpp:430
#, kde-format
msgid "Unknown folder to delete."
msgstr "תיקייה לא מוכרת למחיקה."

#: contactsresource.cpp:434
#, kde-format
msgid "Unable to delete folder '%1'."
msgstr "לא ניתן למחוק את התיקייה ‚%1’."

#: contactsresource.cpp:449
#, kde-format
msgid "Unable to move file '%1' to '%2', '%2' already exists."
msgstr "לא ניתן להעביר את הקובץ ‚%1’ אל ‚%2’, ‚%2’ כבר קיים."

#: contactsresource.cpp:463
#, kde-format
msgid "Unable to move directory '%1' to '%2', '%2' already exists."
msgstr "לא ניתן להעביר את התיקייה ‚%1’ אל ‚%2’, ‚%2’ כבר קיים."

#. i18n: ectx: label, entry (Path), group (General)
#: contactsresource.kcfg:10
#, kde-format
msgid "Path to contacts directory"
msgstr "נתיב לתיקיית קשר"

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: contactsresource.kcfg:14
#, kde-format
msgid "Do not change the actual backend data."
msgstr "לא לשנות את נתוני המנגנון בפועל."

#. i18n: ectx: label, entry (ActivitiesEnabled), group (Activities)
#: contactsresource.kcfg:23
#, kde-format
msgid "Whether the activities support of the agent is enabled"
msgstr "האם התמיכה בפעילויות בסוכן פעילה"

#. i18n: ectx: label, entry (Activities), group (Activities)
#: contactsresource.kcfg:27
#, kde-format
msgid "The activities of the agent"
msgstr "הפעילויות בסוכן"

#: contactssettingswidget.cpp:40
#, kde-format
msgid "Activities"
msgstr "פעילויות"
