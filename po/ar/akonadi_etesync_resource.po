#: setupwizard.cpp:28
#, kde-format
msgctxt "@title:window"
msgid "EteSync configuration wizard"
msgstr "معالج ضبط EteSync"

#: setupwizard.cpp:88
#, kde-format
msgid "Login Credentials"
msgstr "مؤهّلات الولوج"

#: setupwizard.cpp:89
#, kde-format
msgid "Enter your credentials to login to the EteSync server"
msgstr "أدخل بيانات الاعتماد الخاصة بك لتسجيل الدخول إلى خادم EteSync"

#: setupwizard.cpp:98
#, kde-format
msgid "Username:"
msgstr "اسم المستخدم:"

#: setupwizard.cpp:104
#, kde-format
msgid "Password:"
msgstr "كلمة السّر:"

#: setupwizard.cpp:107
#, kde-format
msgctxt "@option:check"
msgid "Advanced settings"
msgstr "إعدادات متقدّمة"

#: setupwizard.cpp:112
#, kde-format
msgid "Server:"
msgstr "الخادم:"

#: setupwizard.cpp:125
#, kde-format
msgid ""
"🛈 The password field is empty because EteSync does not store it for security "
"reasons."
msgstr "🛈 حقل كلمة السر فارغ لأن EteSync لا يخزنه لأسباب أمنية."

#: setupwizard.cpp:157
#, kde-format
msgid ""
"Please ensure that the server URL is correct. The URL should start with "
"http:// or https://."
msgstr ""
"يرجى التأكد من صحة عنوان URL للخادم. يجب أن يبدأ عنوان URL بـ http:// أو "
"https://."

#: setupwizard.cpp:159
#, kde-format
msgid ""
"Could not connect to the server. Please ensure that the server URL is "
"correct."
msgstr "تعذر الاتصال بالخادم. يرجى التأكد من صحة عنوان URL للخادم."

#: setupwizard.cpp:161
#, kde-format
msgid "EteSync server not found. Please ensure that the server URL is correct."
msgstr "خادم EteSync غير موجود. يرجى التأكد من صحة عنوان URL للخادم."
