#: maildirresource.cpp:399
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "المجلّد المصدر غير صالح: ’%1‘."

#: maildirresource.cpp:405
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "المجلّد المقص غير صالح: ’%1‘."

#: maildirresource.cpp:422
#, kde-format
msgid "Could not move message '%1' from '%2' to '%3'. The error was %4."
msgstr "تعذّر نقل الرّسالة ’%1‘ من ’%2‘ إلى ’%3‘. الخطأ هو %4."

#: maildirresource.cpp:444
#, kde-format
msgid "Failed to delete message: %1"
msgstr "فشل حذف الرّسالة: %1"

#: maildirresource.cpp:533
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "‏MailDir ‏’%1‘ للتّجميعة ’%2‘ غير صالح."

#: maildirresource.cpp:612
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "تعذّرت إعادة تسمية مجلّد MailDir ‏’%1‘."

#: maildirresource.cpp:633
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "تعذّر نقل مجلّد MailDir الجذر ’%1‘."

#: maildirresource.cpp:648
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr "تعذّر نقل مجلّد MailDir ‏’%1‘ من ’%2‘ إلى ’%3‘."

#: maildirresource.cpp:666
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "لا يمكن حذف مجلّد Maildir الفوقيّ ’%1‘."

#: maildirresource.cpp:675
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "فشل حذف المجلّد ’%1‘ الفرعيّ."

#: maildirresource.cpp:689
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "تعذّر إنشاء Maildir ‏’%1‘."

#: maildirresource.cpp:699
#, kde-format
msgid "No usable storage location configured."
msgstr "لم يُضبط مكان لتخزين يمكن استخدامه."

