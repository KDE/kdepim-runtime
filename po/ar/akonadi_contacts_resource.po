#, kde-format
msgid "Unable to create folder '%1'."
msgstr "تعذّر إنشاء المجلّد ’%1‘."

#: contactsresource.cpp:406
#, kde-format
msgid "Unable to rename folder '%1'."
msgstr "تعذّرت إعادة تسمية المجلّد ’%1‘."

#: contactsresource.cpp:424
#, kde-format
msgid "Unknown folder to delete."
msgstr "مجلد مجهول للحذف"

#: contactsresource.cpp:428
#, kde-format
msgid "Unable to delete folder '%1'."
msgstr "تعذّر حذف المجلّد ’%1‘."

#: contactsresource.cpp:443
#, kde-format
msgid "Unable to move file '%1' to '%2', '%2' already exists."
msgstr "تعذّ نقل الملفّ ’%1‘ إلى ’%2‘، ف‍’%2‘ موجود فعلًا."

#: contactsresource.cpp:457
#, kde-format
msgid "Unable to move directory '%1' to '%2', '%2' already exists."
msgstr "تعذّ نقل الدّليل ’%1‘ إلى ’%2‘، ف‍’%2‘ موجود فعلًا."

