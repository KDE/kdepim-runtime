#: contactsresource.cpp:257 contactsresource.cpp:272 contactsresource.cpp:307
#: contactsresource.cpp:319
#, kde-format
msgid "Unable to write to file '%1': %2"
msgstr "تعذّرت الكتابة إلى الملفّ ’%1‘: %2"

#: contactsresource.cpp:291 contactsresource.cpp:339
#, kde-format
