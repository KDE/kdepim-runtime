#: libmaildir/maildir.cpp:212 libmaildir/maildir.cpp:217
#, kde-format
msgid "Error opening %1; this folder is missing."
msgstr "Chyba otvárania %1; tento priečinok chýba."

#: libmaildir/maildir.cpp:223
#, kde-format
msgid ""
"Error opening %1; either this is not a valid maildir folder, or you do not "
"have sufficient access permissions."
msgstr ""
"Chyba otvorenia %1; buď to nie je platný poštový priečinok, alebo nemáte "
"dostatočné práva na prístup."

#: libmaildir/maildir.cpp:450 libmaildir/maildir.cpp:472
#: libmaildir/maildir.cpp:490 libmaildir/maildir.cpp:510
#: libmaildir/maildir.cpp:529 libmaildir/maildir.cpp:553
#: libmaildir/maildir.cpp:628 libmaildir/maildir.cpp:778
#, kde-format
msgid "Cannot locate mail file %1."
msgstr "Nemôžem lokalizovať súbor mailu %1."

#: libmaildir/maildir.cpp:456 libmaildir/maildir.cpp:478
#, kde-format
msgid "Cannot open mail file %1."
msgstr "Nemôžem otvoriť súbor mailu %1."

#: libmaildir/maildir.cpp:561 libmaildir/maildir.cpp:588
#, kde-format
msgid "Cannot write to mail file %1."
msgstr "Nemôžem zapisovať do súboru mailu %1."

#: libmaildir/maildir.cpp:602
#, kde-format
msgid "Failed to create mail file %1. The error was: %2"
msgstr "Zlyhalo vytvorenie súboru mailu %1. Chyba bola: %2"

#: libmaildir/maildir.cpp:696
#, kde-format
msgid "Failed to update the file name %1 to %2 on the disk. The error was: %3."
msgstr "Zlyhala aktualizácia názvu súboru %1 na %2 na disku. Chyba bola: %3."

#: maildirresource.cpp:126 maildirresource.cpp:260 maildirresource.cpp:299
#: maildirresource.cpp:393 maildirresource.cpp:434 maildirresource.cpp:554
#: maildirresource.cpp:584 maildirresource.cpp:627 maildirresource.cpp:660
#, kde-format
msgid "Unusable configuration."
msgstr "Nepoužiteľná konfigurácia."

#: maildirresource.cpp:191
#, kde-format
msgid "Unable to fetch item: The maildir folder \"%1\" is not valid."
msgstr "Nemôžem stiahnuť položku: Priečinok maildir \"%1\" nie je platný."

#: maildirresource.cpp:271
#, kde-format
msgid "Error: Unsupported type."
msgstr "Chyba: Nepodporovaný typ."

#: maildirresource.cpp:337
#, kde-format
msgid "Failed to change the flags for the mail. %1"
msgstr "Zlyhala zmena príznakov pre mail. %1"

#: maildirresource.cpp:372
#, kde-format
msgid "Maildir resource got a non-mail content."
msgstr "Zdroj Maildir dostal nemailový obsah."

#: maildirresource.cpp:399
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "Zdrojový priečinok je neplatný: '%1'."

#: maildirresource.cpp:405
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "Cieľový priečinok je neplatný: '%1'."

#: maildirresource.cpp:422
#, kde-format
msgid "Could not move message '%1' from '%2' to '%3'. The error was %4."
msgstr "Nie je možné presunúť správu '%1' z '%2' do '%3'. Chyba bola %4."

#: maildirresource.cpp:444
#, kde-format
msgid "Failed to delete message: %1"
msgstr "Zlyhalo vymazanie správy: %1"

#: maildirresource.cpp:533
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "Maildir '%1' pre kolekciu '%2' je neplatný."

#: maildirresource.cpp:612
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "Nie je možné premenovať priečinok maildir '%1'."

#: maildirresource.cpp:633
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "Nemôžem presunúť koreňový priečinok adresára pošty '%1'."

#: maildirresource.cpp:648
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr "Nemôžem presunúť priečinok maildir '%1' z '%2' do '%3'."

#: maildirresource.cpp:666
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "Nemôžem vymazať koreňový maildir priečinok '%1'."

#: maildirresource.cpp:675
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "Zlyhalo vytvorenie podpriečinka '%1'."

#: maildirresource.cpp:689
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "Nemôžem vytvoriť adresár pošty '%1'."

#: maildirresource.cpp:699
#, kde-format
msgid "No usable storage location configured."
msgstr "Nie je nastavené žiadne použiteľné miesto úložiska."

