msgstr "Не удалось удалить папку %1."

#: contactsresource.cpp:443
#, kde-format
msgid "Unable to move file '%1' to '%2', '%2' already exists."
msgstr "Не удалось переместить файл «%1» в «%2»: «%2» уже существует."

#: contactsresource.cpp:457
#, kde-format
msgid "Unable to move directory '%1' to '%2', '%2' already exists."
msgstr "Не удалось переместить папку «%1» в «%2»: «%2» уже существует."

