#: configwidget.cpp:37
#, kde-format
msgid "Archive Folder"
msgstr "Carpeta de archivo comprimido"

#: configwidget.cpp:40
#, kde-format
msgid "Activities"
msgstr "Actividades"

#: configwidget.cpp:55
#, kde-format
msgid "The selected path is empty."
msgstr "La ruta seleccionada está vacía."

#: configwidget.cpp:68
#, kde-format
msgid "The selected path contains valid Maildir folders."
msgstr "La ruta seleccionada contiene carpetas Maildir válidas."

#: configwidget.cpp:75
#, kde-format
msgid "The selected path is a valid Maildir."
msgstr "La ruta seleccionada es un Maildir válido."

#: configwidget.cpp:81
#, kde-format
msgid "The selected path does not exist yet, a new Maildir will be created."
msgstr "La ruta seleccionada no existe, se creará un nuevo Maildir."

#: configwidget.cpp:85
#, kde-format
msgid "The selected path does not exist."
msgstr "La ruta seleccionada no existe."

#: libmaildir/maildir.cpp:212 libmaildir/maildir.cpp:217
#, kde-format
msgid "Error opening %1; this folder is missing."
msgstr "Error al abrir %1; está carpeta se ha perdido."

#: libmaildir/maildir.cpp:223
#, kde-format
msgid ""
"Error opening %1; either this is not a valid maildir folder, or you do not "
"have sufficient access permissions."
msgstr ""
"Error al abrir %1; bien no es una carpeta válida maildir, o usted no dispone "
"de suficientes permisos de acceso."

#: libmaildir/maildir.cpp:450 libmaildir/maildir.cpp:472
#: libmaildir/maildir.cpp:490 libmaildir/maildir.cpp:510
#: libmaildir/maildir.cpp:529 libmaildir/maildir.cpp:553
#: libmaildir/maildir.cpp:628 libmaildir/maildir.cpp:778
#, kde-format
msgid "Cannot locate mail file %1."
msgstr "No se puede localizar el archivo de correo %1."

#: libmaildir/maildir.cpp:456 libmaildir/maildir.cpp:478
#, kde-format
msgid "Cannot open mail file %1."
msgstr "No se puede abrir el archivo de correo %1."

#: libmaildir/maildir.cpp:561 libmaildir/maildir.cpp:588
#, kde-format
msgid "Cannot write to mail file %1."
msgstr "No se puede escribir el archivo de correo %1."

#: libmaildir/maildir.cpp:602
#, kde-format
msgid "Failed to create mail file %1. The error was: %2"
msgstr "Ha fallado al crear el archivo de correo %1. El error fue: %2"

#: libmaildir/maildir.cpp:696
#, kde-format
msgid "Failed to update the file name %1 to %2 on the disk. The error was: %3."
msgstr ""
"Ha fallado al actualizar el archivo denominado %1 a %2 en el disco. El error "
"fue: %3."

#: maildirresource.cpp:126 maildirresource.cpp:260 maildirresource.cpp:299
#: maildirresource.cpp:393 maildirresource.cpp:434 maildirresource.cpp:554
#: maildirresource.cpp:584 maildirresource.cpp:627 maildirresource.cpp:660
#, kde-format
msgid "Unusable configuration."
msgstr "Configuración no utilizable."

#: maildirresource.cpp:191
#, kde-format
msgid "Unable to fetch item: The maildir folder \"%1\" is not valid."
msgstr ""
"No es posible obtener el elemento: La carpeta maildir «%1» no es válida."

#: maildirresource.cpp:271
#, kde-format
msgid "Error: Unsupported type."
msgstr "Error: Tipo no admitido."

#: maildirresource.cpp:337
#, kde-format
msgid "Failed to change the flags for the mail. %1"
msgstr "Ha fallado al cambiar los indicadores para el correo. %1"

#: maildirresource.cpp:372
#, kde-format
msgid "Maildir resource got a non-mail content."
msgstr "Un recurso de Maildir tomó un contenido que no es correo."

#: maildirresource.cpp:399
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "La carpeta de origen no es válida: «%1»."

#: maildirresource.cpp:405
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "La carpeta de destino no es válida: «%1»."

#: maildirresource.cpp:422
#, kde-format
msgid "Could not move message '%1' from '%2' to '%3'. The error was %4."
msgstr ""
"No se ha podido mover el mensaje «%1» desde «%2» a «%3». El error fue %4."

#: maildirresource.cpp:444
#, kde-format
msgid "Failed to delete message: %1"
msgstr "Ha fallado al borrar el mensaje: %1"

#: maildirresource.cpp:533
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "El Maildir «%1» de la colección «%2» no es válido."

#: maildirresource.cpp:612
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "No es posible cambiar de nombre la carpeta maildir «%1»."

#: maildirresource.cpp:633
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "No se puede mover la carpeta maildir raíz «%1»."

#: maildirresource.cpp:648
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr "No es posible mover la carpeta maildir «%1» de «%2» a «%3»."

#: maildirresource.cpp:666
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "No se puede borrar la carpeta maildir raíz «%1»."

#: maildirresource.cpp:675
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "Ha fallado borrar la subcarpeta «%1»."

#: maildirresource.cpp:689
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "No se puede crear el maildir «%1»."

#: maildirresource.cpp:699
#, kde-format
msgid "No usable storage location configured."
msgstr "No se ha configurado una ubicación de almacenamiento utilizable."

#. i18n: ectx: label, entry (Path), group (General)
#: maildirresource.kcfg:10
#, kde-format
msgid "Path to maildir"
msgstr "Ruta a la carpeta de correo"

#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: maildirresource.kcfg:14
#, kde-format
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr ""
"La ruta apunta a una carpeta que contiene Maildirs en lugar de a un maildir "
"en sí."

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: maildirresource.kcfg:18
#, kde-format
msgid "Do not change the actual backend data."
msgstr "No modificar los datos reales del motor."

#. i18n: ectx: label, entry (ActivitiesEnabled), group (Activities)
#: maildirresource.kcfg:27
#, kde-format
msgid "Whether the activities support of the agent is enabled"
msgstr ""
"Indica si la compatibilidad con las actividades del agente está activada"

#. i18n: ectx: label, entry (Activities), group (Activities)
#: maildirresource.kcfg:31
#, kde-format
msgid "The activities of the agent"
msgstr "Las actividades del agente"

