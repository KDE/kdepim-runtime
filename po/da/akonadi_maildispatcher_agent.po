#: maildispatcheragent.cpp:79 maildispatcheragent.cpp:224
#, kde-format
msgid "Sending messages (1 item in queue)…"
msgid_plural "Sending messages (%1 items in queue)..."
msgstr[0] "Sender breve (1 element i kø)…"
msgstr[1] "Sender breve (%1 elementer i kø…"

#: maildispatcheragent.cpp:89
#, kde-format
msgid "Sending canceled."
msgstr "Afsendelse annulleret."

#: maildispatcheragent.cpp:96
#, kde-format
msgid "Finished sending messages."
msgstr "Afsendelse af breve gennemført."

#: maildispatcheragent.cpp:102
#, kde-format
msgctxt "Notification title when email was sent"
msgid "E-Mail Successfully Sent"
msgstr "E-mail sendt"

#: maildispatcheragent.cpp:103
#, kde-format
msgctxt "Notification when the email was sent"
msgid "Your E-Mail has been sent successfully."
msgstr "Din e-mail er blevet sendt."

#: maildispatcheragent.cpp:109
#, kde-format
msgid "No items in queue."
msgstr "Ingen elementer i kø."

#: maildispatcheragent.cpp:154
#, kde-format
msgid "Online, sending messages in queue."
msgstr "Online, afsender breve i kø."

#: maildispatcheragent.cpp:158
#, kde-format
msgid "Offline, message sending suspended."
msgstr "Offline, afsendelse af breve suspenderet."

#: maildispatcheragent.cpp:184
#, kde-format
msgctxt "Message with given subject is being sent."
msgid "Sending: %1"
msgstr "Sender: %1"

#: maildispatcheragent.cpp:249
#, kde-format
msgctxt "Notification title when email sending failed"
msgid "E-Mail Sending Failed"
msgstr "Afsendelse af e-mail mislykkedes"

#: maildispatcheragent.cpp:282
#, kde-format
msgid "Ready to dispatch messages."
msgstr "Klar til at afsende breve."

#. i18n: ectx: label, entry (Outbox), group (General)
#: maildispatcheragent.kcfg:10
#, kde-format
msgid "Outbox collection id"
msgstr "Samlings-id for udbakke"

#. i18n: ectx: label, entry (SentMail), group (General)
#: maildispatcheragent.kcfg:14
#, kde-format
msgid "Sent Mail collection id"
msgstr "Samlings-id for Sendte e-mails"

#: outboxqueue.cpp:263
#, kde-format
msgid "Could not access the outbox folder (%1)."
msgstr "Kunne ikke tilgå udbakke-mappen (%1)."

#: sendjob.cpp:47 sendjob.cpp:48
#, kde-format
msgid "Message sending aborted."
msgstr "Afsendelse af brev afbrudt."

#: sendjob.cpp:57
#, kde-format
msgid "Could not initiate message transport. Possibly invalid transport."
msgstr "Kunne ikke initiere brevtransport. Muligvis ugyldig transport."

#: sendjob.cpp:63
#, kde-format
msgid "Could not send message. Invalid transport."
msgstr "Kunne ikke sende breve. Ugyldig transport."

#: sendjob.cpp:95
#, kde-format
msgid "Failed to get D-Bus interface of resource %1."
msgstr "Kunne ikke nå D-Bus-grænseflade for ressourcen %1."

#: sendjob.cpp:108
#, kde-format
msgid "Invalid D-Bus reply from resource %1."
msgstr "Ugyldigt D-Bus-svar fra ressourcen %1."

#: sendjob.cpp:229
#, kde-format
msgid "Default sent-mail folder unavailable. Keeping message in outbox."
msgstr ""
"Standardmappe til sendte e-mails er ikke tilgængelig. Beholder brev i "
"udbakke."

#: sendjob.cpp:241
#, kde-format
msgid "Message transport aborted."
msgstr "Brevtransport afbrudt."

#: sendjob.cpp:241
#, kde-format
msgid "Failed to transport message."
msgstr "Kunne ikke transportere brev."

#: sendjob.cpp:245
#, kde-format
msgid ""
"Possible solution: review your send mail settings (authentication, port, "
"encryption type, etc.)"
msgstr ""

#: sendjob.cpp:288
#, kde-format
msgid "Failed to get D-Bus interface of mailfilteragent."
msgstr "Kunne ikke hente D-Bus-grænseflade for mailfilteragent."

#: sendjob.cpp:295
#, kde-format
msgid "Invalid D-Bus reply from mailfilteragent"
msgstr "Ugyldigt D-Bus-svar fra mailfilteragent"

#: sendjob.cpp:337
#, kde-format
msgid "Sending succeeded, but failed to remove the message from the outbox."
msgstr "Afsendelse gennemført, men kunne ikke fjerne brevet fra udbakken."

#: sendjob.cpp:340
#, kde-format
msgid ""
"Sending succeeded, but failed to move the message to the sent-mail folder."
msgstr ""
"Afsendelse gennemført, men kunne ikke flytte brevet til mappen sendte e-"
"mails."

#: sendjob.cpp:376
#, kde-format
msgid "Failed to store result in item."
msgstr "Kunne ikke lagre resultat i elementet."

#: storeresultjob.cpp:59
#, kde-format
msgid "Failed to fetch item."
msgstr "Kunne ikke hente elementet."

