#: configwidget.cpp:37
#, kde-format
msgid "Archive Folder"
msgstr "Arkistokansio"

#: configwidget.cpp:40
#, kde-format
msgid "Activities"
msgstr "Aktiviteetit"

#: configwidget.cpp:55
#, kde-format
msgid "The selected path is empty."
msgstr "Valittu sijainti on tyhjä."

#: configwidget.cpp:68
#, kde-format
msgid "The selected path contains valid Maildir folders."
msgstr "Valitussa sijainnissa on kelvollisia maildir-kansioita."

#: configwidget.cpp:75
#, kde-format
msgid "The selected path is a valid Maildir."
msgstr "Valittu sijainti on kelvollinen maildir-kansio."

#: configwidget.cpp:81
#, kde-format
msgid "The selected path does not exist yet, a new Maildir will be created."
msgstr "Valittua sijaintia ei ole vielä olemassa: uusi maildir-kansio luodaan."

#: configwidget.cpp:85
#, kde-format
msgid "The selected path does not exist."
msgstr "Valittua sijaintia ei ole olemassa."

#: libmaildir/maildir.cpp:212 libmaildir/maildir.cpp:217
#, kde-format
msgid "Error opening %1; this folder is missing."
msgstr "Virhe avattaessa %1; tämä kansio puuttuu."

#: libmaildir/maildir.cpp:223
#, kde-format
msgid ""
"Error opening %1; either this is not a valid maildir folder, or you do not "
"have sufficient access permissions."
msgstr ""
"Virhe avattaessa %1; joko tämä ei ole kelvollinen maildir-kansio tai sinulla "
"ei ole riittäviä oikeuksia."

#: libmaildir/maildir.cpp:450 libmaildir/maildir.cpp:472
#: libmaildir/maildir.cpp:490 libmaildir/maildir.cpp:510
#: libmaildir/maildir.cpp:529 libmaildir/maildir.cpp:553
#: libmaildir/maildir.cpp:628 libmaildir/maildir.cpp:778
#, kde-format
msgid "Cannot locate mail file %1."
msgstr "Postitiedostoa %1 ei voi paikallistaa."

#: libmaildir/maildir.cpp:456 libmaildir/maildir.cpp:478
#, kde-format
msgid "Cannot open mail file %1."
msgstr "Postitiedostoa %1 ei voi avata."

#: libmaildir/maildir.cpp:561 libmaildir/maildir.cpp:588
#, kde-format
msgid "Cannot write to mail file %1."
msgstr "Postitiedostoon %1 ei voi kirjoittaa."

#: libmaildir/maildir.cpp:602
#, kde-format
msgid "Failed to create mail file %1. The error was: %2"
msgstr "Postitiedoston %1 luonti epäonnistui. Virhe oli: %2"

#: libmaildir/maildir.cpp:696
#, kde-format
msgid "Failed to update the file name %1 to %2 on the disk. The error was: %3."
msgstr "Ei saatu muutettua tiedostonimeä %1 nimeksi %2 levyllä. Virhe oli: %3."

#: maildirresource.cpp:124 maildirresource.cpp:256 maildirresource.cpp:295
#: maildirresource.cpp:389 maildirresource.cpp:430 maildirresource.cpp:550
#: maildirresource.cpp:580 maildirresource.cpp:623 maildirresource.cpp:656
#, kde-format
msgid "Unusable configuration."
msgstr "Käyttökelvottomat asetukset."

#: maildirresource.cpp:189
#, kde-format
msgid "Unable to fetch item: The maildir folder \"%1\" is not valid."
msgstr "Tietuetta ei voi noutaa: maildir-kansio ”%1” ei ole kelvollinen."

#: maildirresource.cpp:267
#, kde-format
msgid "Error: Unsupported type."
msgstr "Virhe: Tyyppiä ei tueta."

# Vai kävisikö väännöslaina ”lippujen”?
#: maildirresource.cpp:333
#, kde-format
msgid "Failed to change the flags for the mail. %1"
msgstr "Viestin tilailmaisimien muuttaminen epäonnistui. %1"

#: maildirresource.cpp:368
#, kde-format
msgid "Maildir resource got a non-mail content."
msgstr "Maildir-resurssi sai muuta kuin postisisältöä."

#: maildirresource.cpp:395
#, kde-format
msgid "Source folder is invalid: '%1'."
msgstr "Lähdekansio on virheellinen: ”%1”."

#: maildirresource.cpp:401
#, kde-format
msgid "Destination folder is invalid: '%1'."
msgstr "Kohdekansio on virheellinen: ”%1”."

#: maildirresource.cpp:418
#, kde-format
msgid "Could not move message '%1' from '%2' to '%3'. The error was %4."
msgstr ""
"Viestiä ”%1” ei voitu siirtää kansiosta ”%2” kansioon ”%3”. Virhe oli %4."

#: maildirresource.cpp:440
#, kde-format
msgid "Failed to delete message: %1"
msgstr "Viestin poistaminen epäonnistui: %1"

#: maildirresource.cpp:529
#, kde-format
msgid "Maildir '%1' for collection '%2' is invalid."
msgstr "Maildir ”%1” kokoelmalle ”%2” on virheellinen."

#: maildirresource.cpp:608
#, kde-format
msgid "Unable to rename maildir folder '%1'."
msgstr "Maildir-kansion ”%1” nimeä ei voi muuttaa."

#: maildirresource.cpp:629
#, kde-format
msgid "Cannot move root maildir folder '%1'."
msgstr "Maildir-juurikansiota ”%1” ei voi siirtää."

#: maildirresource.cpp:644
#, kde-format
msgid "Unable to move maildir folder '%1' from '%2' to '%3'."
msgstr "Maildir-kansiota ”%1” ei voi siirtää sijainnista ”%2” sijaintiin ”%3”."

#: maildirresource.cpp:662
#, kde-format
msgid "Cannot delete top-level maildir folder '%1'."
msgstr "Ylimmän tason maildir-kansiota ”%1” ei voi poistaa."

#: maildirresource.cpp:671
#, kde-format
msgid "Failed to delete sub-folder '%1'."
msgstr "Alikansion ”%1” poistaminen epäonnistui."

#: maildirresource.cpp:685
#, kde-format
msgid "Unable to create maildir '%1'."
msgstr "Maildir-kansiota ”%1” ei voi luoda."

#: maildirresource.cpp:695
#, kde-format
msgid "No usable storage location configured."
msgstr "Käyttökelpoista taltiosijaintia ei määritetty."

#. i18n: ectx: label, entry (Path), group (General)
#: maildirresource.kcfg:10
#, kde-format
msgid "Path to maildir"
msgstr "Polku maildir-kansioon"

#. i18n: ectx: label, entry (TopLevelIsContainer), group (General)
#: maildirresource.kcfg:14
#, kde-format
msgid ""
"Path points to a folder containing Maildirs instead of to a maildir itself."
msgstr ""
"Polku osoittaa maildir-kansioita sisältävään kansioon eikä maildir-kansioon "
"itseensä."

#. i18n: ectx: label, entry (ReadOnly), group (General)
#: maildirresource.kcfg:18
#, kde-format
msgid "Do not change the actual backend data."
msgstr "Älä muuta tietoja varsinaisessa taustaosassa."

