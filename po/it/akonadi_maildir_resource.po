#: libmaildir/maildir.cpp:212 libmaildir/maildir.cpp:217
#, kde-format
msgid "Error opening %1; this folder is missing."
msgstr "Errore nell'apertura di %1; la cartella è mancante."

#: libmaildir/maildir.cpp:223
#, kde-format
msgid ""
"Error opening %1; either this is not a valid maildir folder, or you do not "
"have sufficient access permissions."
msgstr ""
"Errore nell'apertura di %1; o non è una cartella maildir valida, oppure non "
"hai permessi sufficienti per accedervi."

#: libmaildir/maildir.cpp:450 libmaildir/maildir.cpp:472
#: libmaildir/maildir.cpp:490 libmaildir/maildir.cpp:510
