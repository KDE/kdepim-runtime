#, kde-format
msgid "Failed to create mail file %1. The error was: %2"
msgstr "Neuspjelo kreiranje datoteke pošte %1. Greška je bila: %2"

#: libmaildir/maildir.cpp:696
#, kde-format
msgid "Failed to update the file name %1 to %2 on the disk. The error was: %3."
msgstr ""
"Neuspjelo ažuriranje imena datoteke %1 u %2 na disku. Greška je bila: %3."

#: maildirresource.cpp:124 maildirresource.cpp:256 maildirresource.cpp:295
